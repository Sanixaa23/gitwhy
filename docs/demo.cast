[6.415, "o", "\r\n"]
[6.445, "o", "\u001b[96m## What happened\u001b[0m\r\n"]
[6.475, "o", "\r\n"]
[6.505, "o", "A rebase stopped halfway. Git was moving your commits one by one onto a new base and got\r\n"]
[6.535, "o", "stuck on one of them. While this lasts you appear to be on no branch — `git status` says\r\n"]
[6.565, "o", "\"detached\", but that is not the real problem; the unfinished rebase is.\r\n"]
[6.595, "o", "\r\n"]
[6.625, "o", "\u001b[96m## Where you are\u001b[0m\r\n"]
[6.655, "o", "\r\n"]
[6.685, "o", "- Repository: `C:\\Users\\Dorsay\\AppData\\Local\\Temp\\gitwhy_demo_40jblxcr\\project`\r\n"]
[6.715, "o", "- Operation in progress: rebase-merge\r\n"]
[6.745, "o", "- Conflicted files (1): a.txt\r\n"]
[6.775, "o", "- HEAD: `7d0e22c`\r\n"]
[6.805, "o", "\r\n"]
[6.835, "o", "\u001b[96m## What to do\u001b[0m\r\n"]
[6.865, "o", "\r\n"]
[6.895, "o", "To finish the rebase: fix the conflicted files, then\r\n"]
[6.925, "o", "\r\n"]
[6.955, "o", "    git add .\r\n"]
[6.985, "o", "    git rebase --continue\r\n"]
[7.015, "o", "\r\n"]
[7.045, "o", "To skip this one commit:\r\n"]
[7.075, "o", "\r\n"]
[7.105, "o", "    git rebase --skip\r\n"]
[7.135, "o", "\r\n"]
[7.165, "o", "To undo the whole rebase and go back where you started:\r\n"]
[7.195, "o", "\r\n"]
[7.225, "o", "    git rebase --abort\r\n"]
[7.255, "o", "\r\n"]
[7.285, "o", "\u001b[33m> WARNING: `git rebase --skip` drops the changes of the commit it skips, and\u001b[0m\r\n"]
[7.315, "o", "> `git rebase --abort` PERMANENTLY deletes the conflict fixes you made during the\r\n"]
[7.345, "o", "> rebase. Neither can be undone. gitwhy never runs these for you.\r\n"]
