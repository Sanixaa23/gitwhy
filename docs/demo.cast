[1.725, "o", "\r\n"]
[1.755, "o", "Auto-merging a.txt\r\n"]
[1.785, "o", "\u001b[31mCONFLICT (content): Merge conflict in a.txt\u001b[0m\r\n"]
[1.815, "o", "\u001b[31merror: could not apply 6dfdc84... ozellik eklendi\u001b[0m\r\n"]
[1.845, "o", "\u001b[90mhint: Resolve all conflicts manually, mark them as resolved with\u001b[0m\r\n"]
[1.875, "o", "\u001b[90mhint: \"git add/rm <conflicted_files>\", then run \"git rebase --continue\".\u001b[0m\r\n"]
[1.905, "o", "\u001b[90mhint: You can instead skip this commit: run \"git rebase --skip\".\u001b[0m\r\n"]
[1.935, "o", "\u001b[90mhint: To abort and get back to the state before \"git rebase\", run \"git rebase --abort\".\u001b[0m\r\n"]
[1.965, "o", "\u001b[90mhint: Disable this message with \"git config set advice.mergeConflict false\"\u001b[0m\r\n"]
[1.995, "o", "Could not apply 6dfdc84... # ozellik eklendi\r\n"]
[5.395, "o", "\u001b[32mogrenci@hackathon ~/proje (ozellik) $ \u001b[0m"]
[5.44, "o", "\u001b[97mg\u001b[0m"]
[5.485, "o", "\u001b[97mi\u001b[0m"]
[5.53, "o", "\u001b[97mt\u001b[0m"]
[5.575, "o", "\u001b[97mw\u001b[0m"]
[5.62, "o", "\u001b[97mh\u001b[0m"]
[5.665, "o", "\u001b[97my\u001b[0m"]
[6.415, "o", "\r\n"]
[6.445, "o", "\u001b[96m## Ne oldu\u001b[0m\r\n"]
[6.475, "o", "\r\n"]
[6.505, "o", "Bir rebase yarıda kaldı. Git commit'lerini tek tek yeni tabana taşırken bir tanesinde\r\n"]
[6.535, "o", "takıldı. Bu sırada hiçbir branch üzerinde görünmezsin — `git status` \"detached\" der ama\r\n"]
[6.565, "o", "asıl sorun bu değil, sürmekte olan rebase'dir.\r\n"]
[6.595, "o", "\r\n"]
[6.625, "o", "\u001b[96m## Neredesin\u001b[0m\r\n"]
[6.655, "o", "\r\n"]
[6.685, "o", "- Depo: `C:\\Users\\Dorsay\\AppData\\Local\\Temp\\gitwhy_demo_8c52t2ii\\proje`\r\n"]
[6.715, "o", "- Süren işlem: rebase-merge\r\n"]
[6.745, "o", "- Çakışan dosya (1): a.txt\r\n"]
[6.775, "o", "- HEAD: `c3162a6`\r\n"]
[6.805, "o", "\r\n"]
[6.835, "o", "\u001b[96m## Ne yapmalısın\u001b[0m\r\n"]
[6.865, "o", "\r\n"]
[6.895, "o", "Rebase'i bitirmek istiyorsan: çakışan dosyaları düzelt, sonra\r\n"]
[6.925, "o", "\r\n"]
[6.955, "o", "    git add .\r\n"]
[6.985, "o", "    git rebase --continue\r\n"]
[7.015, "o", "\r\n"]
[7.045, "o", "Bu tek commit'i atlamak istiyorsan:\r\n"]
[7.075, "o", "\r\n"]
[7.105, "o", "    git rebase --skip\r\n"]
[7.135, "o", "\r\n"]
[7.165, "o", "Rebase'i tamamen geri alıp başladığın yere dönmek istiyorsan:\r\n"]
[7.195, "o", "\r\n"]
[7.225, "o", "    git rebase --abort\r\n"]
[7.255, "o", "\r\n"]
[7.285, "o", "\u001b[33m> UYARI: `git rebase --skip` atladığı commit'in değişikliklerini bırakır; `git rebase --abort`\u001b[0m\r\n"]
[7.315, "o", "> ise rebase sırasında yaptığın çakışma düzeltmelerini KALICI olarak siler. İkisi de geri\r\n"]
[7.345, "o", "> alınamaz. gitwhy bu komutları kendiliğinden çalıştırmaz.\r\n"]
