[1.725, "o", "\r\n"]
[1.755, "o", "Auto-merging a.txt\r\n"]
[1.785, "o", "\u001b[31mCONFLICT (content): Merge conflict in a.txt\u001b[0m\r\n"]
[1.815, "o", "\u001b[31merror: could not apply 274a0aa... add feature\u001b[0m\r\n"]
[1.845, "o", "\u001b[90mhint: Resolve all conflicts manually, mark them as resolved with\u001b[0m\r\n"]
[1.875, "o", "\u001b[90mhint: \"git add/rm <conflicted_files>\", then run \"git rebase --continue\".\u001b[0m\r\n"]
[1.905, "o", "\u001b[90mhint: You can instead skip this commit: run \"git rebase --skip\".\u001b[0m\r\n"]
[1.935, "o", "\u001b[90mhint: To abort and get back to the state before \"git rebase\", run \"git rebase --abort\".\u001b[0m\r\n"]
[1.965, "o", "\u001b[90mhint: Disable this message with \"git config set advice.mergeConflict false\"\u001b[0m\r\n"]
[1.995, "o", "Could not apply 274a0aa... # add feature\r\n"]
[5.395, "o", "\u001b[32mstudent@hackathon ~/project (feature) $ \u001b[0m"]
[5.44, "o", "\u001b[97mg\u001b[0m"]
[5.485, "o", "\u001b[97mi\u001b[0m"]
[5.53, "o", "\u001b[97mt\u001b[0m"]
[5.575, "o", "\u001b[97mw\u001b[0m"]
